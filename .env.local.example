# Single shared password that gates access to the app
APP_PASSWORD=change-me-to-a-strong-shared-password

# 32-byte random hex used to HMAC-sign the auth cookie
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-64-hex-characters

# Supabase project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (server-only — NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API key for the smart layer (chat / recommend / refine-settings)
OPENAI_API_KEY=sk-...
